# Configuration pour le système de prédiction Loto

# Port et host du serveur Flask
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=False

# Origines CORS supplémentaires (séparées par des virgules), ex:
# EXTRA_CORS_ORIGINS=https://mon-domaine.fr,https://www.mon-domaine.fr
EXTRA_CORS_ORIGINS=

# Ré-entraînement automatique des modèles au démarrage (audit M5).
# Laisser à False : un simple warning de version ne doit pas supprimer les modèles.
AUTO_RETRAIN=False

# Configuration VPS / déploiement (audit L2 : ne jamais committer de valeurs réelles,
# ne pas déployer en root). Renseignez ces variables dans votre .env local uniquement.
VPS_IP=
VPS_DOMAIN=
VPS_PATH=
VPS_USER=

# Clés API (Optionnel)
OPENAI_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Modèles AI (Optionnel)
OPENAI_MODEL=gpt-4o-mini-2024-07-18
GROK_MODEL=grok-4-latest
OPENROUTER_MODEL=anthropic/claude-opus-4.1
